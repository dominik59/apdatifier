#!/usr/bin/env bash

source "$(dirname "$0")/utils"
source "$(dirname "$0")/arguments"

parseArguments() {
    splitArguments "$1" && return 0
    printError "$UPGRADE_ARGUMENTS"
    return 2
}

operation="$1"; shift
transaction=""
if [[ "$1" == "--transaction" ]]; then
    transaction="$2"; shift 2
fi
[[ -n "$transaction" ]] || transaction="$(date +%s)-$$"
canceled=false
sequenceCode=0
hasPython=false
[[ -x /usr/bin/python3 ]] && hasPython=true
trap 'canceled=true' SIGINT

state() {
    [[ "$hasPython" == true ]] || return 0
    /usr/bin/python3 -I -B "$scriptDir/../backends.py" lifecycle "$@" >/dev/null
}

state start --id "$transaction" --pid "$$" || exit 1

run() {
    printf '\n'; printf '%q ' "$@"; printf '\n\n'
    if [ "$idleInhibit" = true ]; then
        systemd-inhibit --what=idle:sleep:shutdown --who="Apdatifier" --why="$UPGRADE_PROGRESS" "$@"
    else
        "$@"
    fi
}

printClose() {
    [[ -t 0 ]] || return 0
    tput civis
    printMsg "$UPGRADE_ENTER"

    while ! read -t 30 -r; do
        if command -v gdbus >/dev/null; then
            gdbus call --session \
                --dest org.kde.plasmashell \
                --object-path /org/kde/osdService \
                --method org.kde.osdService.showText \
                apdatifier-plasmoid "$UPGRADE_RESULT" >/dev/null 2>&1
        fi
    done

    tput cnorm
    [[ $(basename "$terminal") = "yakuake" ]] && qdbusCMD sessions removeSession "$(qdbusCMD sessions activeSessionId)"
}

parseArguments "$sudoBin" || exit $?
administrator=("${parsedArguments[@]}")
bin=("${administrator[@]}" pacman)
if [[ "$aur" == true ]]; then
    parseArguments "$wrapper" || exit $?
    bin=("${parsedArguments[@]}")
fi

critical_packages=(
    "amd-ucode"
    "intel-ucode"
    "cryptsetup"
    "linux"
    "linux-hardened"
    "linux-lts"
    "linux-zen"
    "linux-rt"
    "linux-rt-lts"
    "linux-firmware*"
    "linux-cachyos*"
    "linux-cacule*"
    "nvidia"
    "nvidia-dkms"
    "nvidia-*xx-dkms"
    "nvidia-*xx"
    "nvidia-*lts-dkms"
    "nvidia*-lts"
    "mkinitcpio*"
    "booster*"
    "mesa"
    "systemd*"
    "wayland"
    "virtualbox-guest-utils"
    "virtualbox-host-dkms"
    "virtualbox-host-modules-arch"
    "egl-wayland"
    "xf86-video-*"
    "xorg-server*"
    "xorg-fonts*"
    "winesync-dkms"
)

arch_upgrade() {
    printMsg "$UPGRADE_FULL_ARCH"
    echo

    [ "$mirrors" != "false" ] && "$scriptDir"/mirrorlist

    if [ "$rebootSystem" = true ]; then
        for package in "${critical_packages[@]}"; do
            matches=$(pacman -Qq | grep -E "^${package//\*/.*}$")
            [ -n "$matches" ] && critical_installed+=($matches)
        done

        declare -A beforeVersions
        for pkg in "${critical_installed[@]}"; do
            beforeVersions[$pkg]=$(pacman -Q $pkg | awk '{print $2}')
        done
    fi

    test -f "$configDir/env.sh" && source "$configDir/env.sh"

    parseArguments "$archFlags" || return $?
    local flags=("${parsedArguments[@]}")
    run "${bin[@]}" -Syu "${flags[@]}" "$@"
    local result=$?

    for pkg in "${critical_installed[@]}"; do
        afterVersion=$(pacman -Q $pkg | awk '{print $2}')
        if [ "${beforeVersions[$pkg]}" != "$afterVersion" ]; then
            critical_updated+=("$pkg")
        fi
    done
    return "$result"
}

flatpak_upgrade() {
    printMsg "$UPGRADE_FULL_FLATPAK"
    echo

    parseArguments "$flatpakFlags" || return $?
    local flags=("${parsedArguments[@]}")
    run flatpak update "${flags[@]}" || return $?

    if [ "$flatpakRemoveUnused" = true ]; then
        echo
        run flatpak uninstall --unused "${flags[@]}"
    fi
}

widgets_upgrade() {
    printMsg "$UPGRADE_FULL_WIDGETS"
    echo
    run "$scriptDir/widgets" upgradeAll
}

fwupd_upgrade() {
    printMsg "fwupdmgr"
    echo
    run "${administrator[@]}" fwupdmgr update
}

finish() {
    state finish --id "$transaction"
    trap ' ' SIGINT

    endTime=$(date +%s)
    runTime=$((endTime-startTime))
    echo; echo
    printImportant "$UPGRADE_EXECTIME" "$(printf "%02dh:%02dm:%02ds" $((runTime / 3600)) $(( (runTime % 3600) / 60 )) $((runTime % 60)))"

    if [ ${#critical_updated[@]} -gt 0 ]; then
        echo
        printImportant "$UPGRADE_CRITICAL" "${critical_updated[*]}"
        while true; do
            printQuestion "$UPGRADE_REBOOT"; read -r answer
            case "$answer" in
                    [Yy]*) sys_reboot; exit;;
                 [Nn]*|"") break;;
                        *)  ;;
            esac
        done
    fi

    printClose
}

native_upgrade() {
    local source="$1"; shift
    [[ "$hasPython" == true ]] || { printError "System Python 3 is unavailable"; return 127; }
    /usr/bin/python3 -I -B "$scriptDir/../backends.py" foreground "$source" "$@" --transaction "$transaction"
}

stage() {
    [[ "$canceled" == true ]] && return 130
    local source="$1"; shift
    "$@"
    local result=$?
    [[ "$canceled" == true ]] && result=130
    printImportant "$source" "$UPGRADE_STAGE: $result"
    [[ "$result" -eq 130 ]] && canceled=true
    if [[ "$result" -eq 130 ]]; then sequenceCode=130
    elif [[ "$result" -ne 0 && "$sequenceCode" -eq 0 ]]; then sequenceCode=1
    fi
    state stage --id "$transaction" --stage "$source" --code "$result"
    return "$result"
}

fullSystemUpgrade() {
    if [[ "$arch" == true || "$aur" == true ]]; then stage pacman arch_upgrade "$@"; fi
    [[ "$apt" == true ]] && stage apt native_upgrade apt upgrade
    [[ "$snap" == true ]] && stage snap native_upgrade snap refresh
    [[ "$flatpak" == true ]] && stage flatpak flatpak_upgrade
    [[ "$widgets" == true ]] && stage widgets widgets_upgrade
    [[ "$fwupd" == true ]] && stage fwupd fwupd_upgrade
}

sys_reboot() {
    tput civis
    printMsg "$UPGRADE_REBOOTING"

    read -s -t 2

    qdbus6 org.kde.Shutdown /Shutdown logoutAndReboot
}

flatpak_package() {
    printMsg "$UPGRADE_PACKAGE: $2"
    echo

    printExec "flatpak update" "$1 $flatpakFlags"

    parseArguments "$flatpakFlags" || return $?
    local flags=("${parsedArguments[@]}")
    local scope=()
    case "$3" in
        user) scope=(--user) ;;
        system|default) scope=(--system) ;;
        "") ;;
        *) scope=("--installation=$3") ;;
    esac
    run flatpak update "${flags[@]}" "${scope[@]}" "$1"
}

widget_package() {
    printMsg "$UPGRADE_PACKAGE: $2"
    echo

    run "$scriptDir/widgets" upgrade "$1" "$2"
}


startTime=$(date +%s)
critical_updated=()
critical_installed=()

if [[ -n "$preExec" ]]; then stage pre-script run bash -c "$preExec"; fi

if [[ "$canceled" != true ]]; then
case "$operation" in
          "full") fullSystemUpgrade "$@" ;;
        "system") stage pacman arch_upgrade "$@" ;;
           "apt") stage apt native_upgrade apt upgrade ;;
          "snap") stage snap native_upgrade snap refresh ;;
       "apt-pkg") stage apt native_upgrade apt upgrade-package "$1" ;;
      "snap-pkg") stage snap native_upgrade snap refresh "$1" ;;
       "flatpak") stage flatpak flatpak_upgrade ;;
       "widgets") stage widgets widgets_upgrade ;;
         "fwupd") stage fwupd fwupd_upgrade ;;
   "flatpak-pkg") stage flatpak flatpak_package "$1" "$2" "$3" ;;
    "widget-pkg") stage widgets widget_package "$1" "$2" ;;
               *) stage arguments false ;;
esac
fi

if [[ -n "$postExec" ]]; then
    wasCanceled="$canceled"
    canceled=false
    stage post-script run bash -c "$postExec"
    [[ "$wasCanceled" == true ]] && canceled=true
fi
finish
exit "$sequenceCode"
